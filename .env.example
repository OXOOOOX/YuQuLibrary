# Local development only. Copy this file to .env in the repository root.
ENABLE_PLAYBACK_PROBE=1
# Set this only after creating a dedicated local development database.
DATABASE_URL=postgresql://yuqu:local_development_only@127.0.0.1:5432/yuqu_development

# Exact public origin. Production requires HTTPS.
YUQU_ORIGIN=http://127.0.0.1:3000
# Generate a private random secret, at least 32 characters. Do not commit it.
YUQU_AUTH_SECRET=
# local is development-only: writes test messages, does NOT send email.
MAIL_MODE=local
# Required absolute directory, outside tracked source. Example on Windows:
MAIL_OUTBOX_DIR=C:/Users/your-name/yuqu-local/mail
# Production: MAIL_MODE=smtp and configure all four values below.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
# Integration tests require a dedicated database with a name ending in _test.
YUQU_TEST_DATABASE_URL=

# Downloaded media is private and served through authenticated /api/media routes.
MEDIA_STORAGE_DIR=C:/Users/your-name/yuqu-local/media
# Per-account audio quota; pending downloads reserve 100 MiB each. Deleted files
# remain charged until the cleanup worker has removed them. Default: 1 GiB.
YUQU_USER_STORAGE_LIMIT_BYTES=1073741824
# Optional: use fixed Google DNS-over-HTTPS when local DNS returns proxy fake IPs.
# This still rejects non-public addresses and pins each connection to a checked IP.
YUQU_PUBLIC_DNS=0

# Local Qwen3-ASR: full-episode worker plus optional <=60s diagnostic CLI (no cloud ASR).
# Use an isolated Python environment and official model files outside tracked source.
YUQU_ASR_PYTHON=C:/Users/your-name/yuqu-local/asr/.venv/Scripts/python.exe
YUQU_ASR_MODEL_DIR=C:/Users/your-name/yuqu-local/asr/models/asr
YUQU_ASR_ALIGNER_DIR=C:/Users/your-name/yuqu-local/asr/models/aligner
YUQU_ASR_FFMPEG=C:/Users/your-name/yuqu-local/ffmpeg/bin/ffmpeg.exe

# Production HTTPS ASR worker: separate credentials from login and AI Bridge.
# Server stores both values; local worker uses its own private env file with model
# paths, YUQU_ORIGIN and MEDIA_STORAGE_DIR, without DATABASE_URL or SMTP credentials.
YUQU_ASR_WORKER_ID=
YUQU_ASR_WORKER_TOKEN=


# Separate YuQu Bridge credentials, never reuse Cat or a user session token.
YUQU_BRIDGE_PROJECT_ID=yuqu
YUQU_BRIDGE_AGENT_ID=
# Generate 32-128 URL-safe random characters; keep private.
YUQU_BRIDGE_TOKEN=
